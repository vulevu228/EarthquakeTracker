table 'public earthquake_events'
	lineageTag: ab5ad1c6-3925-486b-8324-c3ffdf378712

	measure Earthquakes = COUNTROWS('public earthquake_events')
		formatString: #,##0
		lineageTag: a36ca8a2-cde2-5baf-b29d-01364bf42d01

	measure 'Strongest Magnitude' = MAX('public earthquake_events'[mag])
		formatString: \M0.0
		lineageTag: f5e7fd6d-5cfe-5f68-a57a-43269ad6f766

	measure 'Quakes M5 plus' = CALCULATE(COUNTROWS('public earthquake_events'), 'public earthquake_events'[mag] >= 5)
		formatString: #,##0
		lineageTag: 741e2dc1-c12c-50d7-82d4-385a91f6cb69

	measure 'Quakes M4 plus' = CALCULATE(COUNTROWS('public earthquake_events'), 'public earthquake_events'[mag] >= 4)
		formatString: #,##0
		lineageTag: 9e53645f-417c-55c3-8c13-61ac7988c17a

	measure 'High Alerts' = CALCULATE(COUNTROWS('public earthquake_events'), 'public earthquake_events'[alert] IN {"orange", "red"})
		formatString: #,##0
		lineageTag: 2c7ac821-bcd6-5eca-8759-6f1d8fa75a0b

	measure 'PAGER Alerts' = CALCULATE(COUNTROWS('public earthquake_events'), NOT ISBLANK('public earthquake_events'[alert]))
		formatString: #,##0
		lineageTag: 966d4cc3-6246-5b19-b858-1f8710e21dfe

	measure 'Tsunami Flagged' = CALCULATE(COUNTROWS('public earthquake_events'), 'public earthquake_events'[tsunami] = 1)
		formatString: #,##0
		lineageTag: 824053e2-9f72-52db-b1bd-e3bd5394de4d

	measure 'Average Depth km' = AVERAGE('public earthquake_events'[depth_km])
		formatString: 0
		lineageTag: 77605e95-d467-52ca-8ce3-3eca10073dcd

	measure 'Last 24 Hours' =
			VAR Latest = CALCULATE(MAX('public earthquake_events'[event_time]), ALL('public earthquake_events'))
			RETURN CALCULATE(COUNTROWS('public earthquake_events'), 'public earthquake_events'[event_time] > Latest - 1)
		formatString: #,##0
		lineageTag: fd4a2f74-4d06-57b7-a508-75aaeeac8b95

	measure 'Daily Average' = DIVIDE([Earthquakes], DISTINCTCOUNT('public earthquake_events'[event_date]))
		formatString: #,##0
		lineageTag: 0eae6c31-9ef2-5d1c-a22d-fb733358b3e1

	measure 'Top Region M4 plus' =
			VAR R = RANKX(ALL('public earthquake_events'[region]), [Quakes M4 plus], , DESC, Dense)
			RETURN IF([Quakes M4 plus] > 0 && R <= 10, [Quakes M4 plus])
		formatString: #,##0
		lineageTag: 4687e612-7914-55b1-9a3c-f2cdc087a46b

	measure 'Earthquakes Delta Text' = "about " & FORMAT([Daily Average], "#,##0") & " a day"
		lineageTag: 687482fb-e90b-55a1-9e72-122c7f8df447

	measure 'Last 24 Hours Delta Text' =
			VAR Chg = DIVIDE([Last 24 Hours] - [Daily Average], [Daily Average])
			RETURN IF(ISBLANK(Chg), "no data", IF(Chg >= 0, UNICHAR(9650), UNICHAR(9660)) & " " & FORMAT(ABS(Chg), "0%") & " vs the daily average")
		lineageTag: e3acd509-18e0-56c9-a660-b34ace138fd7

	measure 'Strongest Delta Text' =
			VAR M = [Strongest Magnitude]
			RETURN IF(ISBLANK(M), "no data", CALCULATE(MAX('public earthquake_events'[region]), 'public earthquake_events'[mag] = M) & " · " & FORMAT(CALCULATE(MAX('public earthquake_events'[event_time]), 'public earthquake_events'[mag] = M), "d MMM"))
		lineageTag: fdbfc7c7-bb06-54b8-b710-440a78bddde0

	measure 'M5 plus Delta Text' = IF([Earthquakes] = 0, "no data", FORMAT(DIVIDE([Quakes M5 plus], [Earthquakes]), "0.0%") & " of all earthquakes")
		lineageTag: 8d33bc23-9742-5e81-819a-22c642b05dbe

	measure 'Alerts Delta Text' = "of " & FORMAT([PAGER Alerts], "#,##0") & " with a PAGER alert"
		lineageTag: 75f1b837-2b9c-5cbb-be79-bafe94c084f8

	measure 'Tsunami Delta Text' = "USGS flag for ocean quakes, not a warning"
		lineageTag: 88f7c5ee-8ed2-588d-9cf7-5bca4ad31a57

