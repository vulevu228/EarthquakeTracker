	partition 'public earthquake_events' = m
		mode: import
		source =
				let
				  Source = PostgreSQL.Database("localhost:5432", "earthquake_tracker"),
				  #"Navigation 1" = Source{[Schema = "public", Item = "earthquake_events"]}[Data],
				  #"Added event date" = Table.AddColumn(#"Navigation 1", "event_date", each DateTime.Date(DateTime.From([event_time])), type date),
				  #"Added magnitude band" = Table.AddColumn(#"Added event date", "mag_band", each if [mag] < 2 then "Under 2" else if [mag] < 3 then "2 to 3" else if [mag] < 4 then "3 to 4" else if [mag] < 5 then "4 to 5" else if [mag] < 6 then "5 to 6" else "6 and above", type text),
				  #"Added magnitude order" = Table.AddColumn(#"Added magnitude band", "mag_band_order", each if [mag] < 2 then 1 else if [mag] < 3 then 2 else if [mag] < 4 then 3 else if [mag] < 5 then 4 else if [mag] < 6 then 5 else 6, Int64.Type),
				  #"Added depth band" = Table.AddColumn(#"Added magnitude order", "depth_band", each if [depth_km] < 70 then "Shallow (under 70 km)" else if [depth_km] < 300 then "Intermediate (70 to 300 km)" else "Deep (over 300 km)", type text),
				  #"Added depth order" = Table.AddColumn(#"Added depth band", "depth_band_order", each if [depth_km] < 70 then 1 else if [depth_km] < 300 then 2 else 3, Int64.Type),
				  // region = the part of the USGS place text after the last comma ("68 km NNW of Ende, Indonesia" -> Indonesia)
				  #"Added region" = Table.AddColumn(#"Added depth order", "region", each let t = Text.Trim(Text.Replace(Text.AfterDelimiter([place], ", ", {0, RelativePosition.FromEnd}), " Earthquake", "")), r = if t = null or t = "" then [place] else t in if r = "CA" then "California" else if r = "MX" then "Mexico" else r, type text),
				  #"Added alert level" = Table.AddColumn(#"Added region", "alert_level", each if [alert] = null then null else Text.Proper([alert]), type text),
				  #"Added alert order" = Table.AddColumn(#"Added alert level", "alert_order", each if [alert] = "green" then 1 else if [alert] = "yellow" then 2 else if [alert] = "orange" then 3 else if [alert] = "red" then 4 else null, Int64.Type)
				in
				  #"Added alert order"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

